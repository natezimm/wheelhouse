# The server's nginx needs one site like this per Wheelhouse instance.
#
# Copy it to /etc/nginx/sites-available/<domain>, replace wheelhouse.example.com with the
# instance's domain and 8610 with its WHEELHOUSE_HTTP_PORT, link it into sites-enabled, then
# let certbot add the HTTPS half:  sudo certbot --nginx -d <domain>
server {
    listen 80;
    server_name wheelhouse.example.com;

    location / {
        proxy_pass http://127.0.0.1:8610;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SignalR keeps a WebSocket open, so pass the upgrade through and allow long-lived reads.
    location /hubs/ {
        proxy_pass http://127.0.0.1:8610;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }
}
